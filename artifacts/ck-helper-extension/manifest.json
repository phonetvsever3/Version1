{
  "manifest_version": 3,
  "name": "CK Helper",
  "version": "1.0",
  "description": "Extract cf_clearance cookie and token from CKLottery for use in CK Tester",
  "permissions": ["cookies", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://*.cklottery.club/*",
    "https://*.ckygjf6r.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CK Helper"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
